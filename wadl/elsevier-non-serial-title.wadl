<?xml version="1.0"?>
<!--
Describes the Nonserial Title (metadata) API.

Revision History:

2011-05-07: Initial definition.

2011-09-01: Updates for 11-3 release. Includes:
            - added application title

2011-12-03: Updates for 11-4 release. Includes:
            - added Authorization header field to support oauth

2012-03-17: Updates for 12-1 release. Includes:
            - new response code for Quota Exceeded
            - new resource to return either metadata or cover image for a single nonserial title

2012-07-28: Updates for 12-2 release. Includes:
            - expanded subject category description
			- added query string overrides httpAccept, apiKey, reqId, and ver

2014-06-03: Updates for Sprint 19. Includes:
            - support for application/xml as response mime type

2014-11-04: Updates for Sprint 26. Includes:
            - correct resource for individual metadata titles to include title in the resource URI
-->
<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd" 
			 xmlns:els="urn:elsevier:rs" 
			 xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
             xmlns:eapi="urn:elsevier:api" 
             xmlns:res="http://www.elsevier.com/xml/bkapi/dtd" 
             xmlns:err="http://www.elsevier.com/services/dtd" 
			 xmlns="http://wadl.dev.java.net/2009/02">
	<doc title="Nonserial Title API">This provides interfaces to a search through nonserial titles (Science Direct source metadata).
	  <br/><br/>The following chart shows the <a href="https://${dochostname}/documentation/guides/NonSerialTitleViews.htm">Nonserial Title Views</a>.
	</doc>
	<grammars>
		<include href="bkapi-nonserial-title.xsd"/>
		<include href="Error.xsd"/>
	</grammars>
	<resources base="https://api.elsevier.com/content/nonserial/">
		<resource path="title">
			<doc title="Nonserial Title API">This represents a search against the nonserial titles (Science Direct content).</doc>
			<method name="GET" id="simple">
				<request>
					<param name="Accept" type="xsd:string" style="header" required="true" default="application/json">
						<doc title="accept">This represents the acceptable mime types for which the response can be generated.</doc>
						<option value="application/json"/>
						<option value="text/xml"/>
						<option value="application/xml"/>
					</param>
					<param name="Authorization" type="xsd:string" style="header">
						<doc title="end-user session identifier">This header field contains the OAuth bearer access token, where the format of the field is &quot;Bearer &lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements. The Authorization field overrides X-ELS-Authtoken.</doc>
					</param>
					<param name="X-ELS-APIKey" type="xsd:string" style="header" required="true">
						<doc title="developer identifier">This represents a unique application developer key providing access to resource.</doc>
					</param>
					<param name="X-ELS-Authtoken" type="xsd:string" style="header">
						<doc title="end-user session identifier">This represents a end-user session. If provided, this key is used to validate the credentials needed to access content in this resource.</doc>
					</param>
					<param name="X-ELS-ReqId" type="xsd:string" style="header">
						<doc title="request identifier">This is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
					</param>
					<param name="X-ELS-ResourceVersion" type="xsd:string" style="header">
						<doc title="resource version">Represents the version of the resource that should be received.</doc>
					</param>
					<param name="httpAccept" type="xsd:string" style="query">
						<doc title="accept">Override for HTTP header Accept, this represents the acceptable mime types for which the response can be generated.</doc>
						<option value="application/json"/>
						<option value="text/xml"/>
					</param>
					<param name="access_token" type="xsd:string" style="query">
						<doc title="end-user session identifier">Override for HTTP header Authorization, this contains the OAuth bearer access token, where the format of the field is &quot;&lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements.</doc>
					</param>
					<param name="apiKey" type="xsd:string" style="query">
						<doc title="developer identifier">Override for HTTP header X-ELS-APIKey, this represents a unique application developer key providing access to resource.</doc>
					</param>
					<param name="reqId" type="xsd:string" style="query">
						<doc title="request identifier">Override for HTTP header X-ELS-ReqId, this is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
					</param>
					<param name="ver" type="xsd:string" style="query">
						<doc title="resource version">Override for HTTP header X-ELS-ResourceVersion, this represents the version of the resource that should be received.</doc>
						<option value="application/json"/>
						<option value="text/xml"/>
						<option value="application/xml"/>
					</param>
					<param name="start" type="xsd:string" style="query">
						<doc title="starting position">
							<br/>Numeric value representing the results offset (i.e. starting position for the search results). The maximum for this value is a system-level default (varies with search cluster) minus the number of results requested. If not specified the offset will be set to zero (i.e. first search result)
							<br/>
							<br/>ex. start=5
						</doc>
					</param>
					<param name="count" type="xsd:string" style="query">
						<doc title="number of results">
							<br/>Numeric value representing the maximum number of results to be returned for the search. If not provided this will be set to a system default based on service level.
							<br/>In addition the number cannot exceed the maximum system default ? if it does an error will be returned.
							<br/>
							<br/>ex. count=10
						</doc>
					</param>
					<param name="view" type="xsd:string" style="query" default="STANDARD">
						<doc title="view">The following chart shows the <a href="https://${dochostname}/documentation/guides/NonSerialTitleViews.htm">Nonserial Title Views</a>.</doc>
						<option value="STANDARD"/>
					</param>
					<param name="field" type="xsd:string" style="query">
						<doc title="field">
							This alias represents the name of specific fields that should be returned. The list of fields include all of the fields returned in the response payload (see view).
							<br/>Multiple fields can be specified, delimited by commas.</doc>
					</param>
					<param name="title" type="xsd:string" style="query">
						<doc title="source title">
							<br/>This represents a partial or complete serial title. Will match the pattern provided anywhere within the title -- no wildcard support is provided.
							<br/>
							<br/>ex. title=medicine
						</doc>
					</param>
					<param name="isbn" type="xsd:string" style="query">
						<doc title="isbn">
							<br/>Represents the source identifier filter. One or more identifiers can be provided.
							<br/>
						</doc>
					</param>
					<param name="subj" type="xsd:string" style="query">
						<doc title="content">
							<br/>Represents the Science Direct subject area abbreviation associated with the content category desired. One or more abbreviations can be provided. 
							<br/>
                            <br/>The following resource shows all of the available <a href="https://api.elsevier.com//content/subject/scidir?httpAccept=text/xml">subject classifications</a>.
							<br/>
						</doc>
					</param>
				</request>
				<response status="200">
					<representation mediaType="application/json" element="nonSerialTitleSearchResp.json" href="https://${dochostname}/documentation/payloads/metadata/nonSerialTitleSearchResp.json">
						<doc title="Nonserial Title JSON Response">This is XML representing the requested resource.</doc>
					</representation>
				</response>
				<response status="200">
					<representation mediaType="text/xml" element="nonSerialTitleSearchResp.xml" href="https://${dochostname}/documentation/payloads/metadata/nonSerialTitleSearchResp.xml">
						<doc title="Nonserial Title XML Response">This is XML representing the requested resource.</doc>
					</representation>
				</response>
				<response status="200">
					<representation mediaType="application/xml" element="nonSerialTitleSearchResp.xml" href="https://${dochostname}/documentation/payloads/metadata/nonSerialTitleSearchResp.xml">
						<doc title="Nonserial Title XML Response">This is XML representing the requested resource.</doc>
					</representation>
				</response>
				<response status="400">
					<representation mediaType="text/xml" element="invalidRequest.xml" href="https://${dochostname}/documentation/payloads/invalidRequest.xml">
						<doc title="Invalid Request">This is an error that occurs when invalid information is submitted.</doc>
					</representation>
				</response>
				<response status="401">
					<representation mediaType="text/xml" element="authError.xml" href="https://${dochostname}/documentation/payloads/authError.xml">
						<doc title="Authentication Error">This is an error that occurs when a user cannot be authenticated due to missing/invalid credentials (authtoken or APIKey).</doc>
					</representation>
				</response>
				<response status="405">
					<representation mediaType="text/xml" element="invalidHttpMethod.xml" href="https://${dochostname}/documentation/payloads/invalidHttpMethod.xml">
						<doc title="Invalid HTTP Method">This is an error that occurs when the requested HTTP Method is invalid.</doc>
					</representation>
				</response>
				<response status="406">
					<representation mediaType="text/xml" element="invalidAcceptHeader.xml" href="https://${dochostname}/documentation/payloads/invalidAcceptHeader.xml">
						<doc title="Invalid Mime Type">This is an error that occurs when the requested mime type is invalid.</doc>
					</representation>
				</response>
				<response status="429">
					<representation mediaType="text/xml" element="quotaExceeded.xml" href="https://${dochostname}/documentation/payloads/quotaExceeded.xml">
						<doc title="Quota Exceeded">This is an error that occurs when a requester has exceeded the quota limits associated with their API Key.</doc>
					</representation>
				</response>
				<response status="500">
					<representation mediaType="text/xml" element="genericError.xml" href="https://${dochostname}/documentation/payloads/genericError.xml">
						<doc title="Generic Error">This is a general purpose error condition.</doc>
					</representation>
				</response>
			</method>
		</resource>
		<resource path="title/isbn/{isbn}">
			<doc title="Nonserial Title API">This represents a single nonserial title (Science Direct content) identified by ISBN. This can return either the metadata for that title or the cover image.</doc>
			<method name="GET" id="simple">
				<request>
					<param name="Accept" type="xsd:string" style="header" required="true" default="application/json">
						<doc title="accept">This represents the acceptable mime types for which the response can be generated.</doc>
						<option value="application/json"/>
						<option value="text/xml"/>
						<option value="application/xml"/>
						<option value="image/gif"/>
					</param>
					<param name="Authorization" type="xsd:string" style="header">
						<doc title="end-user session identifier">This header field contains the OAuth bearer access token, where the format of the field is &quot;Bearer &lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements. The Authorization field overrides X-ELS-Authtoken.</doc>
					</param>
					<param name="X-ELS-APIKey" type="xsd:string" style="header" required="true">
						<doc title="developer identifier">This represents a unique application developer key providing access to resource.</doc>
					</param>
					<param name="X-ELS-Authtoken" type="xsd:string" style="header">
						<doc title="end-user session identifier">This represents a end-user session. If provided, this key is used to validate the credentials needed to access content in this resource.</doc>
					</param>
					<param name="X-ELS-ReqId" type="xsd:string" style="header">
						<doc title="request identifier">This is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
					</param>
					<param name="X-ELS-ResourceVersion" type="xsd:string" style="header">
						<doc title="resource version">Represents the version of the resource that should be received.</doc>
					</param>
					<param name="httpAccept" type="xsd:string" style="query">
						<doc title="accept">Override for HTTP header Accept, this represents the acceptable mime types for which the response can be generated.</doc>
						<option value="application/json"/>
						<option value="text/xml"/>
						<option value="application/xml"/>
						<option value="image/gif"/>
					</param>
					<param name="access_token" type="xsd:string" style="query">
						<doc title="end-user session identifier">Override for HTTP header Authorization, this contains the OAuth bearer access token, where the format of the field is &quot;&lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements.</doc>
					</param>
					<param name="apiKey" type="xsd:string" style="query">
						<doc title="developer identifier">Override for HTTP header X-ELS-APIKey, this represents a unique application developer key providing access to resource.</doc>
					</param>
					<param name="reqId" type="xsd:string" style="query">
						<doc title="request identifier">Override for HTTP header X-ELS-ReqId, this is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
					</param>
					<param name="ver" type="xsd:string" style="query">
						<doc title="resource version">Override for HTTP header X-ELS-ResourceVersion, this represents the version of the resource that should be received.</doc>
					</param>
					<param name="view" type="xsd:string" style="query" default="STANDARD">
						<doc title="view">
							The following chart shows the <a href="https://${dochostname}/documentation/guides/NonSerialTitleViews.htm">Nonserial Title Views</a>.
						</doc>
						<option value="STANDARD"/>
						<option value="COVERIMAGE"/>
					</param>
					<param name="field" type="xsd:string" style="query">
						<doc title="field">
							This alias represents the name of specific fields that should be returned. The list of fields include all of the fields returned in the response payload (see view).
							<br/>Multiple fields can be specified, delimited by commas.</doc>
					</param>
				</request>
				<response status="200">
					<representation mediaType="application/json" element="nonSerialTitleResp.json" href="https://${dochostname}/documentation/payloads/metadata/nonSerialTitleResp.json">
						<doc title="Nonserial Title JSON Response">This is XML representing the requested resource.</doc>
					</representation>
				</response>
				<response status="200">
					<representation mediaType="text/xml" element="nonSerialTitleResp.xml" href="https://${dochostname}/documentation/payloads/metadata/nonSerialTitleResp.xml">
						<doc title="Nonserial Title XML Response">This is XML representing the requested resource.</doc>
					</representation>
				</response>
				<response status="200">
					<representation mediaType="application/xml" element="nonSerialTitleResp.xml" href="https://${dochostname}/documentation/payloads/metadata/nonSerialTitleResp.xml">
						<doc title="Nonserial Title XML Response">This is XML representing the requested resource.</doc>
					</representation>
				</response>
				<response status="200">
					<representation mediaType="image/gif" element="nonSerialTitleImage.gif" href="https://${dochostname}/documentation/payloads/metadata/nonSerialTitleImage.gif">
						<doc title="Nonserial Title Cover Image Response">This is the cover image associated with the requested resource.</doc>
					</representation>
				</response>
				<response status="400">
					<representation mediaType="text/xml" element="invalidRequest.xml" href="https://${dochostname}/documentation/payloads/invalidRequest.xml">
						<doc title="Invalid Request">This is an error that occurs when invalid information is submitted.</doc>
					</representation>
				</response>
				<response status="401">
					<representation mediaType="text/xml" element="authError.xml" href="https://${dochostname}/documentation/payloads/authError.xml">
						<doc title="Authentication Error">This is an error that occurs when a user cannot be authenticated due to missing/invalid credentials (authtoken or APIKey).</doc>
					</representation>
				</response>
				<response status="405">
					<representation mediaType="text/xml" element="invalidHttpMethod.xml" href="https://${dochostname}/documentation/payloads/invalidHttpMethod.xml">
						<doc title="Invalid HTTP Method">This is an error that occurs when the requested HTTP Method is invalid.</doc>
					</representation>
				</response>
				<response status="406">
					<representation mediaType="text/xml" element="invalidAcceptHeader.xml" href="https://${dochostname}/documentation/payloads/invalidAcceptHeader.xml">
						<doc title="Invalid Mime Type">This is an error that occurs when the requested mime type is invalid.</doc>
					</representation>
				</response>
				<response status="429">
					<representation mediaType="text/xml" element="quotaExceeded.xml" href="https://${dochostname}/documentation/payloads/quotaExceeded.xml">
						<doc title="Quota Exceeded">This is an error that occurs when a requester has exceeded the quota limits associated with their API Key.</doc>
					</representation>
				</response>
				<response status="500">
					<representation mediaType="text/xml" element="genericError.xml" href="https://${dochostname}/documentation/payloads/genericError.xml">
						<doc title="Generic Error">This is a general purpose error condition.</doc>
					</representation>
				</response>
			</method>
		</resource>
	</resources>
</application>