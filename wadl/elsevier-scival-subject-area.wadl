<?xml version="1.0"?>
<!--
Describes the interfaces for SciVal SUBJECT AREA Lookup API.

Revision History:

2019-06-06: Initial definition.
-->
<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://wadl.dev.java.net/2009/02 wadl.xsd" xmlns:els="urn:elsevier:rs" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:eapi="urn:elsevier:api"
             xmlns:err="http://www.elsevier.com/services/dtd" xmlns="http://wadl.dev.java.net/2009/02">
	<doc title="Subject Area Lookup API">This represents the lookup interfaces associated with SciVal Subject Areas.</doc>
	<grammars/>
	<resources base="https://api.elsevier.com/analytics/scival">
        <resource path="subjectArea">
            <resource path="/classificationType/{classificationType}">
				<doc title="Subject Area Lookup API">This returns all SciVal Subject Areas for a given classification.</doc>
                <method id="getSubjectAreasByClassification" name="GET">
					<request>
						<param name="Accept" type="xsd:string" style="header" required="true" default="application/json">
							<doc title="accept">This represents the acceptable mime types in which the response can be generated. This can also be submitted as the query string parameter &quot;httpAccept&quot;. This returns the response in JSON, ATOM, or XML mark-up.</doc>
							<option value="application/json"/>
							<option value="application/xml"/>
							<option value="text/xml"/>
						</param>
						<param name="Authorization" type="xsd:string" style="header">
							<doc title="end-user session identifier">This header field contains the OAuth bearer access token in which the format of the field is &quot;Bearer &lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements. The Authorization field overrides X-ELS-Authtoken.</doc>
						</param>
						<param name="X-ELS-APIKey" type="xsd:string" style="header" required="true">
							<doc title="developer identifier">This represents a unique application developer key providing access to API resources. This key can also be submitted as the query string parameter &quot;apiKey&quot;</doc>
						</param>
						<param name="X-ELS-Authtoken" type="xsd:string" style="header">
							<doc title="end-user session identifier">This represents a end-user session. If provided, this token is used to validate the credentials needed to access content in this resource. This token can also be submitted through the HTTP header &quot;Authorization&quot; or the query string parameter &quot;access_token&quot;.</doc>
						</param>
						<param name="X-ELS-Insttoken" type="xsd:string" style="header">
							<doc title="institution identifier">This represents a institution token. If provided, this key (in combination with its associated APIKey) is used to establish the credentials needed to access content in this resource. This token can also be provided through the query string parameter &quot;insttoken&quot;.</doc>
						</param>
						<param name="X-ELS-ReqId" type="xsd:string" style="header">
							<doc title="request identifier">This is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. It will also be returned as an HTTP header in the corresponding response. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
						</param>
						<param name="httpAccept" type="xsd:string" style="query">
							<doc title="response format">Override for HTTP header Accept, this represents the acceptable mime types in which the response can be generated.</doc>
							<option value="application/json"/>
							<option value="application/xml"/>
							<option value="text/xml"/>
						</param>
						<param name="access_token" type="xsd:string" style="query">
							<doc title="end-user session identifier">Override for HTTP header Authorization, this contains the OAuth bearer access token, where the format of the field is &quot;&lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements.</doc>
						</param>
						<param name="insttoken" type="xsd:string" style="query">
							<doc title="institution token">Override for HTTP header X-ELS-Insttoken, this represents a institution token. If provided, this key (in combination with its associated APIKey) is used to establish the credentials needed to access content in this resource.</doc>
						</param>
						<param name="apiKey" type="xsd:string" style="query">
							<doc title="developer identifier">Override for HTTP header X-ELS-APIKey, this represents a unique application developer key providing access to resource.</doc>
						</param>
						<param name="reqId" type="xsd:string" style="query">
							<doc title="request identifier">Override for HTTP header X-ELS-ReqId, this is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
						</param>
						<param name="classificationType" style="template" type="xs:string" default="ASJC">
							<doc title="classificationType">This represents the classification type of the subject areas that are being returned.</doc>
							<option value="ASJC"/>
							<option value="FOR"/>
							<option value="FOS"/>
							<option value="KAKEN"/>
							<option value="QS"/>
							<option value="THE"/>
							<option value="SDG"/>
							<option value="POL"/>
							<option value="NIRF"/>
						</param>
					</request>
					<response status="200">
						<representation mediaType="application/json" element="JSON Example" href="https://${dochostname}/documentation/payloads/scival/subjectAreasByClassificationResp.json">
							<doc title="Subject Area JSON Response">This is XML representing the requested document.</doc>
						</representation>
					</response>
					<response status="200">
						<representation mediaType="application/xml" element="XML Example" href="https://${dochostname}/documentation/payloads/scival/subjectAreasByClassificationResp.xml">
							<doc title="Subject Area XML Response">This is XML representing the requested document.</doc>
						</representation>
					</response>
					<response status="200">
						<representation mediaType="text/xml" element="XML Example" href="https://${dochostname}/documentation/payloads/scival/subjectAreasByClassificationTEXTResp.xml">
							<doc title="Subject Area XML Response">This is XML representing the requested document.</doc>
						</representation>
					</response>
					<response status="400">
						<representation mediaType="text/xml" element="Invalid Request Example" href="https://${dochostname}/documentation/payloads/invalidRequest.xml">
							<doc title="Invalid Request">This is an error that occurs when invalid information is submitted.</doc>
						</representation>
					</response>
					<response status="401">
						<representation mediaType="text/xml" element="Authentication Error Example" href="https://${dochostname}/documentation/payloads/authError.xml">
							<doc title="Authentication Error">This is an error that occurs when a user cannot be authenticated due to missing/invalid credentials (authtoken or APIKey).</doc>
						</representation>
					</response>
					<response status="403">
						<representation mediaType="text/xml" element="Authorization Error Example" href="https://${dochostname}/documentation/payloads/authError.xml">
							<doc title="Authorization/Entitlements Error">This is an error that occurs when a user cannot be authenticated or entitlements cannot be validated.</doc>
						</representation>
					</response>
					<response status="405">
						<representation mediaType="text/xml" element="Invalid Method Example" href="https://${dochostname}/documentation/payloads/invalidHttpMethod.xml">
							<doc title="Invalid HTTP Method">This is an error that occurs when the requested HTTP Method is invalid.</doc>
						</representation>
					</response>
					<response status="406">
						<representation mediaType="text/xml" element="Invalid Mime Type Example" href="https://${dochostname}/documentation/payloads/invalidAcceptHeader.xml">
							<doc title="Invalid Mime Type">This is an error that occurs when the requested mime type is invalid.</doc>
						</representation>
					</response>
					<response status="429">
						<representation mediaType="text/xml" element="Quota Exceeded Example" href="https://${dochostname}/documentation/payloads/quotaExceeded.xml">
							<doc title="Quota Exceeded">This is an error that occurs when a requester has exceeded the quota limits associated with their API Key.</doc>
						</representation>
					</response>
					<response status="500">
						<representation mediaType="text/xml" element="Generic Error Example" href="https://${dochostname}/documentation/payloads/genericError.xml">
							<doc title="Generic Error">This is a general purpose error condition, typically due to back-end processing errors.</doc>
						</representation>
					</response>
                </method>
            </resource>
            <resource path="{id}">
				<doc title="Subject Area Lookup API">This represents a lookup for a SciVal Subject Area.</doc>
                <method id="getSubjectArea" name="GET">
					<request>
						<param name="Accept" type="xsd:string" style="header" required="true" default="application/json">
							<doc title="accept">This represents the acceptable mime types in which the response can be generated. This can also be submitted as the query string parameter &quot;httpAccept&quot;. This returns the response in JSON, ATOM, or XML mark-up.</doc>
							<option value="application/json"/>
							<option value="application/xml"/>
							<option value="text/xml"/>
						</param>
						<param name="Authorization" type="xsd:string" style="header">
							<doc title="end-user session identifier">This header field contains the OAuth bearer access token in which the format of the field is &quot;Bearer &lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements. The Authorization field overrides X-ELS-Authtoken.</doc>
						</param>
						<param name="X-ELS-APIKey" type="xsd:string" style="header" required="true">
							<doc title="developer identifier">This represents a unique application developer key providing access to API resources. This key can also be submitted as the query string parameter &quot;apiKey&quot;</doc>
						</param>
						<param name="X-ELS-Authtoken" type="xsd:string" style="header">
							<doc title="end-user session identifier">This represents a end-user session. If provided, this token is used to validate the credentials needed to access content in this resource. This token can also be submitted through the HTTP header &quot;Authorization&quot; or the query string parameter &quot;access_token&quot;.</doc>
						</param>
						<param name="X-ELS-Insttoken" type="xsd:string" style="header">
							<doc title="institution identifier">This represents a institution token. If provided, this key (in combination with its associated APIKey) is used to establish the credentials needed to access content in this resource. This token can also be provided through the query string parameter &quot;insttoken&quot;.</doc>
						</param>
						<param name="X-ELS-ReqId" type="xsd:string" style="header">
							<doc title="request identifier">This is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. It will also be returned as an HTTP header in the corresponding response. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
						</param>
						<param name="httpAccept" type="xsd:string" style="query">
							<doc title="response format">Override for HTTP header Accept, this represents the acceptable mime types in which the response can be generated.</doc>
							<option value="application/json"/>
							<option value="application/xml"/>
							<option value="text/xml"/>
						</param>
						<param name="access_token" type="xsd:string" style="query">
							<doc title="end-user session identifier">Override for HTTP header Authorization, this contains the OAuth bearer access token, where the format of the field is &quot;&lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements.</doc>
						</param>
						<param name="insttoken" type="xsd:string" style="query">
							<doc title="institution token">Override for HTTP header X-ELS-Insttoken, this represents a institution token. If provided, this key (in combination with its associated APIKey) is used to establish the credentials needed to access content in this resource.</doc>
						</param>
						<param name="apiKey" type="xsd:string" style="query">
							<doc title="developer identifier">Override for HTTP header X-ELS-APIKey, this represents a unique application developer key providing access to resource.</doc>
						</param>
						<param name="reqId" type="xsd:string" style="query">
							<doc title="request identifier">Override for HTTP header X-ELS-ReqId, this is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
						</param>
						<param name="id" type="xsd:long" style="template">
							<doc title="id">This represents the ID of the SciVal Subject Area that is being looked up.</doc>
						</param>
						<param name="classificationType" style="template" type="xs:string" default="ASJC">
							<doc title="classificationType">This represents the classification type of the subject area that is being looked up.</doc>
							<option value="ASJC"/>
							<option value="FOR"/>
							<option value="FOS"/>
							<option value="KAKEN"/>
							<option value="QS"/>
							<option value="THE"/>
							<option value="SDG"/>
							<option value="POL"/>
							<option value="NIRF"/>
						</param>
					</request>
					<response status="200">
						<representation mediaType="application/json" element="JSON Example" href="https://${dochostname}/documentation/payloads/scival/subjectAreaLookupResp.json">
							<doc title="Subject Area JSON Response">This is XML representing the requested document.</doc>
						</representation>
					</response>
					<response status="200">
						<representation mediaType="application/xml" element="XML Example" href="https://${dochostname}/documentation/payloads/scival/subjectAreaLookupResp.xml">
							<doc title="Subject Area XML Response">This is XML representing the requested document.</doc>
						</representation>
					</response>
					<response status="200">
						<representation mediaType="text/xml" element="XML Example" href="https://${dochostname}/documentation/payloads/scival/subjectAreaLookupTEXTResp.xml">
							<doc title="Subject Area XML Response">This is XML representing the requested document.</doc>
						</representation>
					</response>
					<response status="400">
						<representation mediaType="text/xml" element="Invalid Request Example" href="https://${dochostname}/documentation/payloads/invalidRequest.xml">
							<doc title="Invalid Request">This is an error that occurs when invalid information is submitted.</doc>
						</representation>
					</response>
					<response status="401">
						<representation mediaType="text/xml" element="Authentication Error Example" href="https://${dochostname}/documentation/payloads/authError.xml">
							<doc title="Authentication Error">This is an error that occurs when a user cannot be authenticated due to missing/invalid credentials (authtoken or APIKey).</doc>
						</representation>
					</response>
					<response status="403">
						<representation mediaType="text/xml" element="Authorization Error Example" href="https://${dochostname}/documentation/payloads/authError.xml">
							<doc title="Authorization/Entitlements Error">This is an error that occurs when a user cannot be authenticated or entitlements cannot be validated.</doc>
						</representation>
					</response>
					<response status="405">
						<representation mediaType="text/xml" element="Invalid Method Example" href="https://${dochostname}/documentation/payloads/invalidHttpMethod.xml">
							<doc title="Invalid HTTP Method">This is an error that occurs when the requested HTTP Method is invalid.</doc>
						</representation>
					</response>
					<response status="406">
						<representation mediaType="text/xml" element="Invalid Mime Type Example" href="https://${dochostname}/documentation/payloads/invalidAcceptHeader.xml">
							<doc title="Invalid Mime Type">This is an error that occurs when the requested mime type is invalid.</doc>
						</representation>
					</response>
					<response status="429">
						<representation mediaType="text/xml" element="Quota Exceeded Example" href="https://${dochostname}/documentation/payloads/quotaExceeded.xml">
							<doc title="Quota Exceeded">This is an error that occurs when a requester has exceeded the quota limits associated with their API Key.</doc>
						</representation>
					</response>
					<response status="500">
						<representation mediaType="text/xml" element="Generic Error Example" href="https://${dochostname}/documentation/payloads/genericError.xml">
							<doc title="Generic Error">This is a general purpose error condition, typically due to back-end processing errors.</doc>
						</representation>
					</response>
                </method>
            </resource>
            <resource path="search">
				<doc title="Subject Area Lookup API">This represents a boolean search for a SciVal Subject Area.</doc>
                <method id="subjectAreaSearch" name="GET">
					<request>
						<param name="Accept" type="xsd:string" style="header" required="true" default="application/json">
							<doc title="accept">This represents the acceptable mime types in which the response can be generated. This can also be submitted as the query string parameter &quot;httpAccept&quot;. This returns the response in JSON, ATOM, or XML mark-up.</doc>
							<option value="application/json"/>
							<option value="application/xml"/>
							<option value="text/xml"/>
						</param>
						<param name="Authorization" type="xsd:string" style="header">
							<doc title="end-user session identifier">This header field contains the OAuth bearer access token in which the format of the field is &quot;Bearer &lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements. The Authorization field overrides X-ELS-Authtoken.</doc>
						</param>
						<param name="X-ELS-APIKey" type="xsd:string" style="header" required="true">
							<doc title="developer identifier">This represents a unique application developer key providing access to API resources. This key can also be submitted as the query string parameter &quot;apiKey&quot;</doc>
						</param>
						<param name="X-ELS-Authtoken" type="xsd:string" style="header">
							<doc title="end-user session identifier">This represents a end-user session. If provided, this token is used to validate the credentials needed to access content in this resource. This token can also be submitted through the HTTP header &quot;Authorization&quot; or the query string parameter &quot;access_token&quot;.</doc>
						</param>
						<param name="X-ELS-Insttoken" type="xsd:string" style="header">
							<doc title="institution identifier">This represents a institution token. If provided, this key (in combination with its associated APIKey) is used to establish the credentials needed to access content in this resource. This token can also be provided through the query string parameter &quot;insttoken&quot;.</doc>
						</param>
						<param name="X-ELS-ReqId" type="xsd:string" style="header">
							<doc title="request identifier">This is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. It will also be returned as an HTTP header in the corresponding response. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
						</param>
						<param name="httpAccept" type="xsd:string" style="query">
							<doc title="response format">Override for HTTP header Accept, this represents the acceptable mime types in which the response can be generated.</doc>
							<option value="application/json"/>
							<option value="application/xml"/>
							<option value="text/xml"/>
						</param>
						<param name="access_token" type="xsd:string" style="query">
							<doc title="end-user session identifier">Override for HTTP header Authorization, this contains the OAuth bearer access token, where the format of the field is &quot;&lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements.</doc>
						</param>
						<param name="insttoken" type="xsd:string" style="query">
							<doc title="institution token">Override for HTTP header X-ELS-Insttoken, this represents a institution token. If provided, this key (in combination with its associated APIKey) is used to establish the credentials needed to access content in this resource.</doc>
						</param>
						<param name="apiKey" type="xsd:string" style="query">
							<doc title="developer identifier">Override for HTTP header X-ELS-APIKey, this represents a unique application developer key providing access to resource.</doc>
						</param>
						<param name="reqId" type="xsd:string" style="query">
							<doc title="request identifier">Override for HTTP header X-ELS-ReqId, this is a client-defined request identifier, which will be logged in all trace messages of the service. This identifier can be used to track a specific transaction in the service&apos;s message logs. Note that this should be a unique identifier for the client, and used to track a single transaction.</doc>
						</param>
						<param name="query" type="xsd:string" style="query" required="true">
							<doc title="search query">
								<br/>This represents the boolean search to be executed to retrieve SciVal Subject Areas.
								<br/>
								<br/>Valid fields are <b>name</b> and <b>classification</b>. Valid operators are <b>OR</b> and <b>AND</b>. 
								<br/>
								<br/>
								<br/>ex. query=name(biology) AND classification(ASJC)
							</doc>
						</param>
						<param name="limit" style="query" type="xs:int" default="100">
							<doc title="result limit">This value specifies the number of results to return. Coupled with offset, it can be utilized to paginate results.</doc>
						</param>
						<param name="offset" style="query" type="xs:int" default="0">
							<doc title="result offset">For paginating results, this is how many pages (of size = limit) to skip before returning results.</doc>
						</param>
					</request>
					<response status="200">
						<representation mediaType="application/json" element="JSON Example" href="https://${dochostname}/documentation/payloads/scival/subjectAreaSearchResp.json">
							<doc title="Institution JSON Response">This is XML representing the requested document.</doc>
						</representation>
					</response>
					<response status="200">
						<representation mediaType="application/xml" element="XML Example" href="https://${dochostname}/documentation/payloads/scival/subjectAreaSearchResp.xml">
							<doc title="Institution XML Response">This is XML representing the requested document.</doc>
						</representation>
					</response>
					<response status="200">
						<representation mediaType="text/xml" element="XML Example" href="https://${dochostname}/documentation/payloads/scival/subjectAreaSearchTEXTResp.xml">
							<doc title="Institution XML Response">This is XML representing the requested document.</doc>
						</representation>
					</response>
					<response status="400">
						<representation mediaType="text/xml" element="Invalid Request Example" href="https://${dochostname}/documentation/payloads/invalidRequest.xml">
							<doc title="Invalid Request">This is an error that occurs when invalid information is submitted.</doc>
						</representation>
					</response>
					<response status="401">
						<representation mediaType="text/xml" element="Authentication Error Example" href="https://${dochostname}/documentation/payloads/authError.xml">
							<doc title="Authentication Error">This is an error that occurs when a user cannot be authenticated due to missing/invalid credentials (authtoken or APIKey).</doc>
						</representation>
					</response>
					<response status="403">
						<representation mediaType="text/xml" element="Authorization Error Example" href="https://${dochostname}/documentation/payloads/authError.xml">
							<doc title="Authorization/Entitlements Error">This is an error that occurs when a user cannot be authenticated or entitlements cannot be validated.</doc>
						</representation>
					</response>
					<response status="405">
						<representation mediaType="text/xml" element="Invalid Method Example" href="https://${dochostname}/documentation/payloads/invalidHttpMethod.xml">
							<doc title="Invalid HTTP Method">This is an error that occurs when the requested HTTP Method is invalid.</doc>
						</representation>
					</response>
					<response status="406">
						<representation mediaType="text/xml" element="Invalid Mime Type Example" href="https://${dochostname}/documentation/payloads/invalidAcceptHeader.xml">
							<doc title="Invalid Mime Type">This is an error that occurs when the requested mime type is invalid.</doc>
						</representation>
					</response>
					<response status="429">
						<representation mediaType="text/xml" element="Quota Exceeded Example" href="https://${dochostname}/documentation/payloads/quotaExceeded.xml">
							<doc title="Quota Exceeded">This is an error that occurs when a requester has exceeded the quota limits associated with their API Key.</doc>
						</representation>
					</response>
					<response status="500">
						<representation mediaType="text/xml" element="Generic Error Example" href="https://${dochostname}/documentation/payloads/genericError.xml">
							<doc title="Generic Error">This is a general purpose error condition, typically due to back-end processing errors.</doc>
						</representation>
					</response>
                </method>
            </resource>
		</resource>
	</resources>
</application>
