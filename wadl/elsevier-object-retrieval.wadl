		<resource path="pubmed_id/{pubmed_id}">
			<doc title="Object Retrieval API">This represents retrieval of <b>object references</b> associated with a full text article by <b>Pubmed ID</b> (Medline ID).</doc>
			<method name="GET" id="simple">
				<request>
					<param name="Accept" type="xsd:string" style="header" required="true" default="text/xml">
