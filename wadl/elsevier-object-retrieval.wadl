		<resource path="eid/{eid}">
			<doc title="Object Retrieval API">This represents retrieval of a <b>specific object</b> associated with a full text article, identified by <b>EID</b> (Electronic Identifier). When specifying a view and a supported mime type (XML, JSON, or RDF), the object metadata will be returned instead of the object itself.</doc>
			<method name="GET" id="simple">
				<request>
					<param name="Accept" type="xsd:string" style="header" required="true" default="*/*">
						<doc title="accept">This represents the acceptable mime types in which the response can be generated. This can also be submitted as the query string parameter &quot;httpAccept&quot;. This returns the response in JSON, ATOM, or XML mark-up.</doc>
						<option value="text/xml"/>
						<option value="application/pdf"/>
						<option value="image/jpeg"/>
						<option value="image/gif"/>
						<option value="image/png"/>
						<option value="image/svg"/>
						<option value="image/tiff"/>
						<option value="application/vnd.ms-excel"/>
						<option value="application/postscript"/>
						<option value="text/mathml"/>
						<option value="application/excel"/>
						<option value="application/ppt"/>
						<option value="application/word"/>
						<option value="text/plain"/>
						<option value="application/rtf"/>
						<option value="video/avi"/>
						<option value="video/x-flv"/>
						<option value="audio/mp3"/>
