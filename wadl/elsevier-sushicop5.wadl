				<response status="401">
				    <representation mediaType="application/json" element="Authentication Error Example">
				        <doc title="Authentication Error">This is an error that occurs when a user cannot be authenticated due to missing/invalid credentials (API key).</doc>
				    </representation>
				</response>
				<response status="403">
				    <representation mediaType="application/json" element="Authorization/Entitlements Error Example">
				        <doc title="Authorization/Entitlements Error">This is an error that occurs when a user cannot be authenticated or entitlements cannot be validated.</doc>
				    </representation>
				</response>
				<response status="405">
				    <representation mediaType="application/json" element="Invalid Method Example">
				        <doc title="Invalid Method">This is an error that occurs when the requested HTTP Method is invalid.</doc>
				    </representation>
				</response>
				<response status="406">
				    <representation mediaType="application/json" element="Invalid Mime Type Example">
				        <doc title="Invalid Mime Type">This is an error that occurs when the requested mime type is invalid.</doc>
				    </representation>
				</response>
				<response status="429">
				    <representation mediaType="application/json" element="Quota Exceeeded Example">
				        <doc title="Quota Exceeded">This is an error that occurs when a requester has exceeded the quota limits associated with their API Key.</doc>
				    </representation>
				</response>
				<response status="500">
					<representation mediaType="application/json" element="Generic Error Example">
						<doc title="Generic Error">This error indicates that the service is unavailable or a fatal error has occurred.</doc>
					</representation>
				</response>
			</method>
		</resource>
		<resource path="reports/{database}">
