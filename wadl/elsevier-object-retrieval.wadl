						<option value="application/json"/>
						<option value="application/rdf+xml"/>
					</param>
					<param name="access_token" type="xsd:string" style="query">
						<doc title="end-user session identifier">Override for HTTP header Authorization, this contains the OAuth bearer access token, where the format of the field is &quot;&lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements.</doc>
