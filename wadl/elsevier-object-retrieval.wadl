						<option value="application/vnd.google-earth.kml+xml"/>
						<option value="application/vnd.google-earth.kmz"/>
					</param>
					<param name="Authorization" type="xsd:string" style="header">
						<doc title="end-user session identifier">This header field contains the OAuth bearer access token in which the format of the field is &quot;Bearer &lt;token&gt;&quot; (where the token represents the end-user session key).  The presence of a bearer token implies the request will be executed against user-based entitlements. The Authorization field overrides X-ELS-Authtoken.</doc>
					</param>
					<param name="X-ELS-APIKey" type="xsd:string" style="header" required="true">
						<doc title="developer identifier">This represents a unique application developer key providing access to API resources. This key can also be submitted as the query string parameter &quot;apiKey&quot;</doc>
					</param>
					<param name="X-ELS-Authtoken" type="xsd:string" style="header">
